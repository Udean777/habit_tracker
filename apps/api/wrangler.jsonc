{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glimkin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "58563860ffff49caaae2b9b0ef457926",
      "localConnectionString": "postgres://postgres:@localhost:5432/habit_tracker"
    }
  ]
}
