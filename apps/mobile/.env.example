# Copy this file to .env.local (gitignored) for local development.
# - Physical device on Wi-Fi: use your machine's LAN IP, e.g. http://192.168.1.7:3000
# - Android emulator: omit (defaults to http://10.0.2.2:3000) or use `adb reverse tcp:3000 tcp:3000` with http://localhost:3000
# - iOS simulator: omit (defaults to http://localhost:3000)
# Never put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://<your local ip>:3000
